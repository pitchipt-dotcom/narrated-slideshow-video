# Copy to config/manual-video.env and fill in the values. Do not commit the real file.
# Every value is intentionally empty here. Defaults used when a value is empty are noted.
MANUAL_JOB_PORT=
MANUAL_JOBS_ROOT=
MANUAL_JOBS_LOGICAL_ROOT=
MANUAL_IMAGE_LIBRARY_ROOT=
MANUAL_IMAGE_LIBRARY_LOGICAL_ROOT=
MANUAL_ALLOWED_TAILSCALE_USERS=
MANUAL_PUBLIC_ORIGIN=

MANUAL_VOICE_PROFILES_PATH=
MANUAL_PRONUNCIATION_DICTIONARY=
MANUAL_IRODORI_URL=
MANUAL_IRODORI_TIMEOUT_MS=
# Optional: let the worker start the Irodori systemd unit only while a job needs
# it and stop it afterwards. Off unless set to 1. Needs polkit/50-manual-video-irodori.rules.
MANUAL_IRODORI_AUTOSTART=
# Unit name (default irodori-tts.service)
MANUAL_IRODORI_UNIT=
# Optional: base URL of another local service that also uses the GPU. When set, the
# worker starts Irodori only while that service reports idle (see README).
MANUAL_GPU_COORDINATOR_URL=
MANUAL_AUDIO_GAP_SECONDS=
# Defaults: 100 / 160 / 40 / 4
TTS_BLOCK_TARGET_CHARS=
TTS_BLOCK_MAX_CHARS=
TTS_BLOCK_MIN_CHARS=
TTS_BLOCK_MAX_SENTENCES=
# Defaults: 1.2 / 6.0 / 0.05
SUBTITLE_MIN_DURATION_SEC=
SUBTITLE_MAX_DURATION_SEC=
SUBTITLE_GAP_SEC=
MANUAL_WORKER_POLL_MS=
MANUAL_WORKER_RETRY_FAILED=
MANUAL_WORKER_MAX_RETRIES=

# Local archive is optional but recommended. NAS archive remains disabled for now.
MANUAL_LOCAL_ARCHIVE_ROOT=
MANUAL_LOCAL_ARCHIVE_LOGICAL_ROOT=
# MANUAL_NAS_ARCHIVE_ROOT=
# MANUAL_NAS_ARCHIVE_LOGICAL_ROOT=
